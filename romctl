#!/bin/bash
#
# romctl - audit and normalize a RetroDECK-style ROM library.
#
# Expects a library root containing roms/<system>/ and, optionally, bios/.
# "check" is read-only. Every other command is a dry run unless --apply is
# given; originals are moved to <system>/_to_delete/ rather than deleted.
#
# Usage: romctl COMMAND [SYSTEM...|all] [--apply] [-r ROOT]
# Run "romctl help" for details.

readonly VERSION="1.0.0"

#------------------------------------------------------------------------------
# System classes (RetroDECK / ES-DE directory names).
#------------------------------------------------------------------------------
# cd:      CD-based; target format CHD (createcd).
# dvd:     DVD-based; target format CHD (createdvd, 2 KiB hunks).
# umd:     PSP; target format CHD (createdvd, 2 KiB hunks; PPSSPP 1.17+).
# arcade:  set-named zips; never renamed, never unpacked.
# dolphin: GameCube/Wii; target format RVZ.
# xbox:    original Xbox; target format XISO.
# ps3:     PS3; disc dumps as ISO (or Title.ps3/ folders).
# n64:     N64; target format big-endian .z64.
# snes:    SNES; headerless .sfc.

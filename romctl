#######################################
# Print a timestamped message to stderr.
# Arguments:
#   Message text.
#######################################
err() {
  echo "[$(date +'%Y-%m-%dT%H:%M:%S%z')]: $*" >&2
}

#######################################
# Print an error and exit non-zero.
# Arguments:
#   Message text.
#######################################
die() {
  err "$1"
  exit 1
}

#######################################
# Print usage.
#######################################
usage() {
  cat <<USAGE
romctl ${VERSION} - audit and normalize a RetroDECK-style ROM library

Usage: romctl COMMAND [SYSTEM...|all] [--apply] [-r ROOT]

Options (may appear anywhere):
  -r, --root DIR   Library root containing roms/ and bios/ (default: .)
      --apply      Perform changes (default: dry run)
  -h, --help       Show this help

Commands:
  check            Audit systems and BIOS files (read-only)
  bios             Audit BIOS files only (read-only)
  detag            Strip region/dump tags; move leading articles to the end
  unpack           Extract single-file archives in cartridge systems
  chd              Convert disc images (dirs, archives, cue/gdi/iso) to CHD
  m3u              Group loose "Title (Disc N).chd" files into Title.m3u/
  dvd              Re-encode DVD images stored as CD-type CHDs
  n64              Normalize N64 ROMs to big-endian .z64
  snes             Strip copier headers; rename .smc to .sfc
  xiso             Rename Xbox XISO images from .iso to .xiso
  rvz              Convert GameCube/Wii images to RVZ
  ps3              Unpack PS3 archives, then build ISOs from disc folders
  clean            Delete _to_delete/ directories
  sync [roms|bios] Mirror roms/ and/or bios/ to the device (default: both).
                   Uses rsync --delete; save data, NVRAM and caches are
                   excluded and never deleted on the device. Reads
                   SYNC_USER, SYNC_HOST and SYNC_PATH from the config file.
  systems          List known systems and their classes

Systems default to "all" (every directory under roms/).
Config file: \${ROMCTL_CONFIG:-\${XDG_CONFIG_HOME:-~/.config}/romctl/config}
Exit status: 0 on success, 1 if check finds failures or a command fails.
USAGE
}

#######################################
# Record and print an audit finding.
# Globals:
#   N_FAIL, N_WARN, N_INFO
# Arguments:
#   Level (FAIL|WARN|INFO), system, path, message, fix hint (optional).
#######################################
report() {
  local level="$1" sys="$2" path="$3" msg="$4" fix="${5:-}"
  case "${level}" in
    FAIL) ((N_FAIL++)) ;;
    WARN) ((N_WARN++)) ;;
    INFO) ((N_INFO++)) ;;
  esac
  if [[ -n "${fix}" ]]; then
    printf '%-4s  %-12s %s: %s  [romctl %s %s]\n' \
      "${level}" "${sys}" "${path}" "${msg}" "${fix}" "${sys}"
  else
    printf '%-4s  %-12s %s: %s\n' "${level}" "${sys}" "${path}" "${msg}"
  fi
}

#######################################
# Announce or perform an action depending on --apply.
# Globals:
#   APPLY
# Arguments:
#   Description.
# Returns:
#   0 if the caller should perform the action, 1 for a dry run.
#######################################
act() {
  if ((APPLY)); then
    echo "do:   $1"
    return 0
  fi
  echo "plan: $1"
  return 1
}

#######################################
# Move a file or directory into its directory's _to_delete/.
# Arguments:
#   Path.
#######################################
retire() {
  local path="$1" dir
  dir="$(dirname -- "${path}")"
  mkdir -p -- "${dir}/_to_delete" || return 1
  mv -n -- "${path}" "${dir}/_to_delete/" || return 1
}

#######################################
# Rename a path, including case-only renames on case-insensitive filesystems
# (where source and target resolve to the same file).
# Arguments:
#   Source path, target path.
#######################################
rename_path() {
  local src="$1" dst="$2" tmp
  if [[ "${dst}" -ef "${src}" ]]; then
    tmp="${src}.romctl-rename.$$"
    mv -n -- "${src}" "${tmp}" || return 1
    mv -n -- "${tmp}" "${dst}" || {
      mv -n -- "${tmp}" "${src}"
      return 1
    }
    return
  fi
  mv -n -- "${src}" "${dst}"
}

#######################################
# Save terminal settings and restore them on exit. External tools (e.g.
# maxcso) can leave the terminal in raw/no-echo mode if they touch it.
# Globals:
#   TTY_STATE
#######################################
save_tty() {
  [[ -t 0 ]] || return 0
  TTY_STATE="$(stty -g 2>/dev/null)" || return 0
  trap 'stty "${TTY_STATE}" 2>/dev/null' EXIT
  trap 'exit 130' INT TERM
}

#######################################
# Require external commands.
# Arguments:
#   Command names.
#######################################
need() {
  local c
  for c in "$@"; do
    command -v "${c}" >/dev/null ||
      die "required command not found: ${c} (run 'make' in the romctl directory)"
  done
}

#######################################
# Read bytes from a file as a lowercase hex string.
# Arguments:
#   File, byte offset, length.
# Outputs:
#   Hex string on stdout.
#######################################
read_hex() {
  local hex
  hex="$(od -An -v -tx1 -j "$2" -N "$3" -- "$1" 2>/dev/null)" || return 1
  hex="${hex//[[:space:]]/}"
  [[ -n "${hex}" ]] || return 1
  echo "${hex}"
}

#######################################
# File size in bytes.
# Arguments:
#   File.
# Outputs:
#   Size on stdout.
#######################################
file_size() {
  stat -c %s -- "$1"
}

#######################################
# Classify a CHD by its metadata.
# Arguments:
#   CHD file.
# Outputs:
#   One of: dvd, gd, cd-dvdimage (single MODE1/2048 track), cd, v<N>, bad.
#######################################
chd_kind() {
  local f="$1" hex tag data
  local -i ver off len next tracks=0 guard=0 mode1=0

  hex="$(read_hex "${f}" 0 8)" || {
    echo bad
    return
  }
  [[ "${hex}" == "${CHD_MAGIC}" ]] || {
    echo bad
    return
  }
  hex="$(read_hex "${f}" 12 4)" || return 1
  ver=$((16#${hex}))
  if ((ver != 5)); then
    echo "v${ver}"
    return
  fi

  hex="$(read_hex "${f}" 48 8)" || return 1
  off=$((16#${hex}))
  while ((off > 0 && guard++ < 256)); do
    hex="$(read_hex "${f}" "${off}" 16)" || break
    tag="${hex:0:8}"
    len=$((16#${hex:10:6}))
    next=$((16#${hex:16:16}))
    case "${tag}" in
      44564420) # "DVD "
        echo dvd
        return
        ;;
      43484744) # "CHGD"
        echo gd
        return
        ;;
      43485432 | 43485452 | 43484344) # CHT2, CHTR, CHCD
        ((tracks++))
        if ((tracks == 1)); then
          data="$(dd if="${f}" iflag=skip_bytes,count_bytes skip=$((off + 16)) \
            count="${len}" status=none | tr -d '\0')"
          [[ "${data}" =~ (^|[[:space:]])TYPE:MODE1[[:space:]] ]] && mode1=1
        fi
        ;;
    esac
    off="${next}"
  done

  if ((tracks == 1 && mode1)); then
    echo cd-dvdimage
  else
    echo cd
  fi
}

#######################################
# Clean a base name: strip tags except (Disc N), move leading article.
# Arguments:
#   Name without extension.
# Outputs:
#   Cleaned name on stdout.
#######################################
clean_name() {
  perl -pe '
    s/\s*\((?!Disc \d+\))[^)]*\)//g;
    s/\s*\[[^]]*\]//g;
    s/^(The|A|An) (?!- )(.+?)( - |$)/$2, $1$3/;
    s/ - the / - The /g;
    s/\s+/ /g;
    s/^\s+|\s+$//g;
  ' <<<"$1"
}

#######################################
# Resolve system arguments to directory names under roms/.
# Runs in the current shell so validation errors stop the program.
# Globals:
#   ROMS, SYSTEMS (set)
# Arguments:
#   System names, or "all"/nothing.
#######################################
resolve_systems() {
  local d s
  SYSTEMS=()
  if (($# == 0)) || [[ "$1" == "all" ]]; then
    for d in "${ROMS}"/*/; do
      d="${d%/}"
      SYSTEMS+=("${d##*/}")
    done
    return
  fi
  for s in "$@"; do
    [[ -d "${ROMS}/${s}" ]] || die "no such system directory: ${ROMS}/${s}"
    SYSTEMS+=("${s}")
  done
}

#######################################
# Test whether a system directory holds any game entries.
# Arguments:
#   System directory path.
#######################################
has_games() {
  local e
  for e in "$1"/*; do
    case "${e##*/}" in
      systeminfo.txt | *.txt | _to_delete | .directory) continue ;;
    esac
    return 0
  done
  return 1
}

#######################################
# Audit one .m3u game directory.
# Arguments:
#   System, directory path.
#######################################
check_m3u_dir() {
  local sys="$1" dir="$2" name playlist line entry
  local -i lines=0 discs=0
  name="${dir##*/}"
  playlist="${dir}/${name}"

  if [[ ! -f "${playlist}" ]]; then
    report FAIL "${sys}" "${name}" "missing playlist ${name}"
    return
  fi
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line}" ]] && continue
    ((lines++))
    [[ -f "${dir}/${line}" ]] ||
      report FAIL "${sys}" "${name}" "playlist entry not found: ${line}"
  done <"${playlist}"
  for entry in "${dir}"/*; do
    [[ "${entry}" == "${playlist}" ]] && continue
    ((discs++))
  done
  ((lines == discs)) ||
    report WARN "${sys}" "${name}" "${discs} disc file(s) but ${lines} playlist entries"
}

#######################################
# Audit one loose file.
# Arguments:
#   System, class, file path.
#######################################
check_file() {
  local sys="$1" class="$2" f="$3"
  local base="${f##*/}" ext name clean kind hex
  ext="${base##*.}"
  ext="${ext,,}"
  name="${base%.*}"

  # Junk and leftovers.
  case "${base}" in
    *.partial.* | *.tmp.* | *.romctl-rename.*)
      report FAIL "${sys}" "${base}" "incomplete conversion leftover; delete it"
      return
      ;;
  esac
  case "${ext}" in
    part | tmp)
      report FAIL "${sys}" "${base}" "incomplete transfer/conversion leftover"
      return
      ;;
    sav | srm | state | sh)
      # Unclassified systems (ports, launchers) legitimately hold scripts.
      if [[ -n "${class}" ]]; then
        report WARN "${sys}" "${base}" "does not belong in roms/"
      fi
      return
      ;;
    txt | ini | cheats | ips | bps | ups | sbi | dat | directory) return ;;
  esac

  # Naming.
  if [[ "${class}" != "arcade" ]]; then
    clean="$(clean_name "${name}")"
    [[ "${clean}" != "${name}" ]] &&
      report WARN "${sys}" "${base}" "naming -> \"${clean}.${ext}\"" detag
    [[ "${name}" =~ \(Disc\ [0-9]+\) ]] &&
      report WARN "${sys}" "${base}" "loose multi-disc file; belongs in a .m3u directory" m3u
  fi

  case "${class}:${ext}" in
    cart:zip | cart:7z | cart:rar | n64:zip | n64:7z | n64:rar | snes:zip | snes:7z | snes:rar)
      report WARN "${sys}" "${base}" "archive; store bare" unpack
      ;;
    cd:cue | cd:gdi | cd:iso | cd:bin | cd:img | cd:ccd | cd:mds | cd:toc | cd:zip | cd:7z | cd:rar)
      [[ "${ext}" == "bin" || "${ext}" == "img" ]] && return # covered by its cue
      report WARN "${sys}" "${base}" "raw/archived disc image; convert to CHD" chd
      ;;
    dvd:iso | dvd:cue | dvd:zip | dvd:7z | dvd:rar)
      report WARN "${sys}" "${base}" "raw/archived disc image; convert to CHD" chd
      ;;
    cd:chd | dvd:chd | umd:chd)
      kind="$(chd_kind "${f}")"
      case "${kind}" in
        bad) report FAIL "${sys}" "${base}" "not a valid CHD" ;;
        v[0-4]) report WARN "${sys}" "${base}" "old CHD ${kind}; re-create with current chdman" ;;
        cd-dvdimage)
          [[ "${class}" == "dvd" ]] &&
            report WARN "${sys}" "${base}" "DVD image stored as CD-type CHD" dvd
          ;;
        dvd)
          [[ "${class}" == "cd" ]] &&
            report FAIL "${sys}" "${base}" "DVD-type CHD in a CD system"
          ;;
      esac
      ;;
    umd:iso | umd:cso)
      report WARN "${sys}" "${base}" "convert to CHD" chd
      ;;
    dolphin:iso | dolphin:gcm | dolphin:wbfs | dolphin:ciso | dolphin:gcz)
      report WARN "${sys}" "${base}" "convert to RVZ" rvz
      ;;
    xbox:iso)
      hex="$(read_hex "${f}" 65536 20)"
      if [[ "${hex}" == "${XISO_MAGIC}" ]]; then
        report INFO "${sys}" "${base}" "XISO with .iso extension" xiso
      else
        report FAIL "${sys}" "${base}" "not an XISO (full disc image?); rebuild with extract-xiso -r"
      fi
      ;;
    xbox:xiso)
      hex="$(read_hex "${f}" 65536 20)"
      [[ "${hex}" == "${XISO_MAGIC}" ]] ||
        report FAIL "${sys}" "${base}" "not a valid XISO"
      ;;
    ps3:iso)
      iso_complete "${f}" ||
        report FAIL "${sys}" "${base}" "ISO is truncated or not ISO9660"
      ;;
    ps3:7z | ps3:zip | ps3:rar)
      report WARN "${sys}" "${base}" "archived PS3 dump" ps3
      ;;
    n64:v64 | n64:n64)
      report WARN "${sys}" "${base}" "byte-swapped N64 ROM" n64
      ;;
    n64:z64)
      hex="$(read_hex "${f}" 0 4)"
      [[ "${hex}" == "${N64_Z64}" ]] ||
        report WARN "${sys}" "${base}" ".z64 with non-native byte order" n64
      ;;
    snes:smc)
      report WARN "${sys}" "${base}" ".smc; use headerless .sfc" snes
      ;;
    snes:sfc)
      (($(file_size "${f}") % 1024 == 512)) &&
        report WARN "${sys}" "${base}" "has 512-byte copier header" snes
      ;;
  esac
}

#######################################
# Audit one subdirectory entry of a system.
# Arguments:
#   System, class, directory path.
#######################################
check_dir() {
  local sys="$1" class="$2" d="$3" base="${3##*/}"
  case "${base}" in
    _to_delete)
      report INFO "${sys}" "${base}" "pending deletion" clean
      return
      ;;
    _extract.*)
      report FAIL "${sys}" "${base}" "leftover extraction directory"
      return
      ;;
    *.m3u)
      check_m3u_dir "${sys}" "${d}"
      return
      ;;
  esac
  case "${class}" in
    cd | dvd)
      report WARN "${sys}" "${base}" "game directory; convert to CHD" chd
      ;;
    ps3)
      if [[ -f "${d}/PS3_GAME/USRDIR/EBOOT.BIN" ]]; then
        report INFO "${sys}" "${base}" "disc folder; could be a single ISO" ps3
      elif [[ -f "${d}/USRDIR/EBOOT.BIN" ]]; then
        report WARN "${sys}" "${base}" "installed/PSN-style folder; needs a license (RAP) and cannot become an ISO"
      else
        report FAIL "${sys}" "${base}" "no EBOOT.BIN found"
      fi
      ;;
  esac
}

#######################################
# Audit one system directory.
# Globals:
#   ROMS, SYSTEM_CLASS
# Arguments:
#   System name.
#######################################
check_system() {
  local sys="$1" class="${SYSTEM_CLASS[$1]:-}" e
  for e in "${ROMS}/${sys}"/* "${ROMS}/${sys}"/.[!.]*; do
    [[ -e "${e}" ]] || continue
    [[ "${e##*/}" == "systeminfo.txt" || "${e##*/}" == ".directory" ]] && continue
    if [[ -d "${e}" ]]; then
      check_dir "${sys}" "${class}" "${e}"
    else
      check_file "${sys}" "${class}" "${e}"
    fi
  done
}

#######################################
# Audit BIOS files for systems that have games, plus any known-hash files.
# Globals:
#   BIOS, ROMS, BIOS_REQUIRED, BIOS_MD5
# Arguments:
#   System names.
#######################################
check_bios() {
  local sys group alt f sum found
  local -a alts groups
  if [[ ! -d "${BIOS}" ]]; then
    report INFO bios "${BIOS}" "no bios/ directory; skipping BIOS checks"
    return
  fi

  for sys in "$@"; do
    [[ -n "${BIOS_REQUIRED[${sys}]:-}" ]] || continue
    has_games "${ROMS}/${sys}" || continue
    read -ra groups <<<"${BIOS_REQUIRED[${sys}]}"
    for group in "${groups[@]}"; do
      IFS='|' read -ra alts <<<"${group}"
      found=0
      for alt in "${alts[@]}"; do
        for f in "${BIOS}"/${alt}; do
          [[ -e "${f}" ]] && found=1
        done
      done
      ((found)) || report FAIL "${sys}" "bios/${group}" "required BIOS missing"
    done
  done

  for f in "${!BIOS_MD5[@]}"; do
    [[ -f "${BIOS}/${f}" ]] || continue
    sum="$(md5sum <"${BIOS}/${f}")" || continue
    sum="${sum%% *}"
    [[ "${sum}" == "${BIOS_MD5[${f}]}" ]] ||
      report FAIL bios "${f}" "MD5 ${sum} does not match reference ${BIOS_MD5[${f}]}"
  done

  if [[ -f "${BIOS}/firmware.bin" ]]; then
    (($(file_size "${BIOS}/firmware.bin") == 262144)) ||
      report WARN bios firmware.bin "unexpected size for DS firmware (want 262144)"
  fi
}

#######################################
# Print the audit summary, highlighted when stdout is a terminal.
# Honors NO_COLOR (https://no-color.org/).
# Globals:
#   N_FAIL, N_WARN, N_INFO
#######################################
summary() {
  local green="" yellow="" red="" reset=""
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m' reset=$'\e[0m'
  fi
  echo
  if ((N_FAIL > 0)); then
    echo "${red}✗ ${N_FAIL} fail${reset}, ${N_WARN} warn, ${N_INFO} info"
  elif ((N_WARN > 0)); then
    echo "${yellow}! ${N_WARN} warn${reset}, ${N_INFO} info"
  elif ((N_INFO > 0)); then
    echo "${green}✓ Clean${reset} (${N_INFO} info)"
  else
    echo "${green}✓ Clean${reset}"
  fi
}

#######################################
# Command: check.
# Arguments:
#   System names.
#######################################
cmd_check() {
  local sys
  for sys in "$@"; do
    check_system "${sys}"
  done
  check_bios "$@"
  summary
  ((N_FAIL == 0))
}

#######################################
# Command: bios.
# Arguments:
#   System names.
#######################################
cmd_bios() {
  check_bios "$@"
  summary
  ((N_FAIL == 0))
}

#######################################
# Command: detag.
# Globals:
#   ROMS, SYSTEM_CLASS
# Arguments:
#   System names.
#######################################
cmd_detag() {
  local sys f base ext name clean dst
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == "arcade" ]] && continue
    for f in "${ROMS}/${sys}"/*; do
      [[ -f "${f}" ]] || continue
      base="${f##*/}"
      [[ "${base}" == systeminfo.txt || "${base}" == .* ]] && continue
      ext="${base##*.}"
      name="${base%.*}"
      clean="$(clean_name "${name}")" || return 1
      [[ "${clean}" == "${name}" ]] && continue
      dst="${ROMS}/${sys}/${clean}.${ext}"
      if [[ -e "${dst}" && ! "${dst}" -ef "${f}" ]]; then
        err "collision, skipped: ${sys}/${base} -> ${clean}.${ext}"
        continue
      fi
      act "rename ${sys}/${base} -> ${clean}.${ext}" || continue
      rename_path "${f}" "${dst}" || err "rename failed: ${sys}/${base}"
    done
  done
}

#######################################
# Command: unpack (single-file archives in cartridge systems).
# Globals:
#   ROMS, SYSTEM_CLASS
# Arguments:
#   System names.
#######################################
cmd_unpack() {
  local sys class a listing tmp inner ext out
  local -i failed=0
  need 7z
  for sys in "$@"; do
    class="${SYSTEM_CLASS[${sys}]:-}"
    [[ "${class}" == cart || "${class}" == n64 || "${class}" == snes ]] || continue
    for a in "${ROMS}/${sys}"/*.{zip,7z,rar}; do
      [[ -f "${a}" ]] || continue
      listing="$(7z l -ba -slt "${a}" 2>/dev/null)" || {
        err "unreadable archive: ${a}"
        ((failed++))
        continue
      }
      if [[ "${listing}" =~ Path\ =.*Path\ = ]]; then
        err "multi-file archive, skipped: ${sys}/${a##*/}"
        continue
      fi
      act "unpack ${sys}/${a##*/}" || continue
      tmp="$(mktemp -d "${ROMS}/${sys}/_extract.XXXX")" || return 1
      if ! 7z x -y -o"${tmp}" "${a}" >/dev/null; then
        err "extraction failed: ${a}"
        rm -rf -- "${tmp}"
        ((failed++))
        continue
      fi
      inner="$(find "${tmp}" -type f -print -quit)"
      ext="${inner##*.}"
      out="${a%.*}.${ext,,}"
      if [[ -e "${out}" ]]; then
        err "exists, skipped: ${out}"
      else
        mv -- "${inner}" "${out}" && retire "${a}"
      fi
      rm -rf -- "${tmp}"
    done
  done
  ((failed == 0))
}

#######################################
# Create and verify one CHD.
# Arguments:
#   Mode (cd|dvd), input image, output CHD.
#######################################
make_chd() {
  local mode="$1" in="$2" out="$3"
  local -a cmd=(chdman createcd)
  [[ "${mode}" == dvd ]] && cmd=(chdman createdvd -hs 2048 -c "lzma,zlib")
  if "${cmd[@]}" -i "${in}" -o "${out}.tmp" </dev/null >/dev/null 2>&1 &&
    chdman verify -i "${out}.tmp" </dev/null >/dev/null 2>&1; then
    mv -- "${out}.tmp" "${out}"
    return
  fi
  rm -f -- "${out}.tmp"
  return 1
}

#######################################
# Decompress a CSO image and convert it to a DVD-type CHD.
# Arguments:
#   CSO file, output CHD.
#######################################
cso_to_chd() {
  local cso="$1" out="$2" tmp
  tmp="$(mktemp -d)" || return 1
  if maxcso --decompress "${cso}" -o "${tmp}/x.iso" </dev/null >/dev/null 2>&1 &&
    make_chd dvd "${tmp}/x.iso" "${out}"; then
    rm -rf -- "${tmp}"
    return
  fi
  rm -rf -- "${tmp}"
  return 1
}

#######################################
# Pick the CHD mode for an image in a given system class.
# Arguments:
#   Class, image path.
# Outputs:
#   cd or dvd.
#######################################
chd_mode() {
  local ext="${2##*.}"
  if [[ "$1" == dvd || "$1" == umd ]] && [[ "${ext,,}" == iso ]]; then
    echo dvd
  else
    echo cd
  fi
}

#######################################
# Convert a directory of disc images (one game) to CHD(s).
# Arguments:
#   Class, system directory, game directory, title.
#######################################
convert_game_dir() {
  local class="$1" sysdir="$2" dir="$3" title="$4"
  local m3u disc img mode
  local -a imgs=()
  local -i n=0

  for img in "${dir}"/*.cue "${dir}"/*.gdi "${dir}"/*.CUE "${dir}"/*.GDI; do
    [[ -f "${img}" ]] && imgs+=("${img}")
  done
  if ((${#imgs[@]} == 0)); then
    for img in "${dir}"/*.iso "${dir}"/*.ISO; do
      [[ -f "${img}" ]] && imgs+=("${img}")
    done
  fi
  ((${#imgs[@]} > 0)) || {
    err "no cue/gdi/iso in: ${dir}"
    return 1
  }

  if ((${#imgs[@]} == 1)); then
    [[ -e "${sysdir}/${title}.chd" ]] && {
      err "exists, skipped: ${title}.chd"
      return 1
    }
    mode="$(chd_mode "${class}" "${imgs[0]}")"
    make_chd "${mode}" "${imgs[0]}" "${sysdir}/${title}.chd"
    return
  fi

  m3u="${sysdir}/${title}.m3u"
  [[ -e "${m3u}" ]] && {
    err "exists, skipped: ${title}.m3u"
    return 1
  }
  mkdir -- "${m3u}" || return 1
  for img in "${imgs[@]}"; do
    ((n++))
    printf -v disc '%s (Disc %02d).chd' "${title}" "${n}"
    mode="$(chd_mode "${class}" "${img}")"
    if ! make_chd "${mode}" "${img}" "${m3u}/${disc}"; then
      rm -rf -- "${m3u}"
      return 1
    fi
    echo "${disc}" >>"${m3u}/${title}.m3u"
  done
}

#######################################
# Command: chd.
# Globals:
#   ROMS, SYSTEM_CLASS
# Arguments:
#   System names.
#######################################
cmd_chd() {
  local sys class sysdir e base title tmp mode
  local -i failed=0
  need chdman
  for sys in "$@"; do
    class="${SYSTEM_CLASS[${sys}]:-}"
    [[ "${class}" == cd || "${class}" == dvd || "${class}" == umd ]] || continue
    sysdir="${ROMS}/${sys}"
    for e in "${sysdir}"/*.cso "${sysdir}"/*.CSO; do
      [[ -f "${e}" ]] && ((APPLY)) && need maxcso
    done
    for e in "${sysdir}"/*; do
      base="${e##*/}"
      [[ "${base}" == _* || "${base}" == *.m3u || "${base}" == systeminfo.txt ]] && continue
      title="$(clean_name "${base%.*}")"
      if [[ -d "${e}" ]]; then
        title="$(clean_name "${base}")"
        act "convert directory ${sys}/${base} -> ${title}" || continue
        if convert_game_dir "${class}" "${sysdir}" "${e}" "${title}"; then
          retire "${e}"
        else
          err "failed, source kept: ${sys}/${base}"
          ((failed++))
        fi
        continue
      fi
      case "${base,,}" in
        *.cso)
          [[ -e "${sysdir}/${title}.chd" ]] && continue
          act "convert ${sys}/${base} -> ${title}.chd" || continue
          if cso_to_chd "${e}" "${sysdir}/${title}.chd"; then
            retire "${e}"
          else
            err "failed, source kept: ${sys}/${base}"
            ((failed++))
          fi
          ;;
        *.cue | *.gdi | *.iso)
          [[ -e "${sysdir}/${title}.chd" ]] && continue
          act "convert ${sys}/${base} -> ${title}.chd" || continue
          mode="$(chd_mode "${class}" "${e}")"
          if make_chd "${mode}" "${e}" "${sysdir}/${title}.chd"; then
            retire "${e}"
          else
            err "failed, source kept: ${sys}/${base}"
            ((failed++))
          fi
          ;;
        *.zip | *.7z | *.rar)
          need 7z
          act "extract and convert ${sys}/${base} -> ${title}" || continue
          tmp="$(mktemp -d "${sysdir}/_extract.XXXX")" || return 1
          if 7z x -y -o"${tmp}" "${e}" >/dev/null &&
            convert_game_dir "${class}" "${sysdir}" "${tmp}" "${title}"; then
            retire "${e}"
          else
            err "failed, source kept: ${sys}/${base}"
            ((failed++))
          fi
          rm -rf -- "${tmp}"
          ;;
      esac
    done
  done
  ((failed == 0))
}

#######################################
# Command: m3u (group loose multi-disc CHDs).
# Globals:
#   ROMS
# Arguments:
#   System names.
#######################################
cmd_m3u() {
  local sys f base title disc dir
  local -A groups=()
  local -a discs
  for sys in "$@"; do
    groups=()
    for f in "${ROMS}/${sys}"/*\(Disc\ *\).chd; do
      [[ -f "${f}" ]] || continue
      base="${f##*/}"
      [[ "${base}" =~ ^(.+)\ \(Disc\ ([0-9]+)\)\.chd$ ]] || continue
      groups["${BASH_REMATCH[1]}"]=1
    done
    for title in "${!groups[@]}"; do
      dir="${ROMS}/${sys}/${title}.m3u"
      [[ -e "${dir}" ]] && {
        err "exists, skipped: ${sys}/${title}.m3u"
        continue
      }
      act "group ${sys}/${title} (Disc N).chd -> ${title}.m3u/" || continue
      mkdir -- "${dir}" || return 1
      mapfile -t discs < <(printf '%s\n' "${ROMS}/${sys}/${title} (Disc "*").chd" | sort -V)
      for f in "${discs[@]}"; do
        [[ "${f##*/}" =~ \(Disc\ ([0-9]+)\)\.chd$ ]] || continue
        printf -v disc '%s (Disc %02d).chd' "${title}" "$((10#${BASH_REMATCH[1]}))"
        mv -n -- "${f}" "${dir}/${disc}" || return 1
        echo "${disc}" >>"${dir}/${title}.m3u"
      done
    done
  done
}

#######################################
# Command: dvd (re-encode DVD images stored as CD-type CHDs).
# Globals:
#   ROMS, SYSTEM_CLASS
# Arguments:
#   System names.
#######################################
cmd_dvd() {
  local sys f work iso cue out
  local -i failed=0
  need chdman
  work="$(mktemp -d)" || return 1
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == dvd ]] || continue
    for f in "${ROMS}/${sys}"/*.chd; do
      [[ -f "${f}" ]] || continue
      [[ "$(chd_kind "${f}")" == cd-dvdimage ]] || continue
      act "re-encode ${sys}/${f##*/} as DVD CHD" || continue
      iso="${work}/x.iso"
      cue="${work}/x.cue"
      out="${work}/out.chd"
      rm -f -- "${iso}" "${cue}" "${out}"
      if chdman extractcd -i "${f}" -o "${cue}" -ob "${iso}" </dev/null >/dev/null 2>&1 &&
        make_chd dvd "${iso}" "${out}" && retire "${f}" &&
        mv -- "${out}" "${f}"; then
        :
      else
        err "failed, original kept: ${f}"
        ((failed++))
      fi
      rm -f -- "${iso}" "${cue}" "${out}"
    done
  done
  rm -rf -- "${work}"
  ((failed == 0))
}

#######################################
# Command: n64 (normalize to big-endian .z64).
# Globals:
#   ROMS, N64_*
# Arguments:
#   System names.
#######################################
cmd_n64() {
  local sys f hex out swap
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == n64 ]] || continue
    for f in "${ROMS}/${sys}"/*.{z64,v64,n64}; do
      [[ -f "${f}" ]] || continue
      hex="$(read_hex "${f}" 0 4)" || continue
      out="${f%.*}.z64"
      case "${hex}" in
        "${N64_Z64}")
          [[ "${f}" == "${out}" ]] && continue
          swap=""
          ;;
        "${N64_V64}") swap='s/(.)(.)/\2\1/gs' ;;
        "${N64_N64}") swap='s/(.)(.)(.)(.)/\4\3\2\1/gs' ;;
        *)
          err "unknown N64 header ${hex}: ${f}"
          continue
          ;;
      esac
      [[ -e "${out}" && "${f}" != "${out}" ]] && {
        err "exists, skipped: ${out}"
        continue
      }
      act "normalize ${sys}/${f##*/} -> ${out##*/}" || continue
      if [[ -z "${swap}" ]]; then
        mv -n -- "${f}" "${out}"
      elif perl -0777 -pe "${swap}" -- "${f}" >"${out}.tmp" &&
        [[ "$(read_hex "${out}.tmp" 0 4)" == "${N64_Z64}" ]]; then
        if [[ "${f}" == "${out}" ]]; then
          retire "${f}" && mv -- "${out}.tmp" "${out}"
        else
          mv -- "${out}.tmp" "${out}" && retire "${f}"
        fi
      else
        rm -f -- "${out}.tmp"
        err "conversion failed: ${f}"
      fi
    done
  done
}

#######################################
# Command: snes (strip copier headers, .smc -> .sfc).
# Globals:
#   ROMS
# Arguments:
#   System names.
#######################################
cmd_snes() {
  local sys f out
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == snes ]] || continue
    for f in "${ROMS}/${sys}"/*.{smc,sfc}; do
      [[ -f "${f}" ]] || continue
      out="${f%.*}.sfc"
      if (($(file_size "${f}") % 1024 == 512)); then
        act "strip header ${sys}/${f##*/} -> ${out##*/}" || continue
        tail -c +513 -- "${f}" >"${out}.tmp" || {
          rm -f -- "${out}.tmp"
          continue
        }
        retire "${f}" && mv -- "${out}.tmp" "${out}"
      elif [[ "${f}" != "${out}" ]]; then
        [[ -e "${out}" ]] && {
          err "exists, skipped: ${out}"
          continue
        }
        act "rename ${sys}/${f##*/} -> ${out##*/}" && mv -n -- "${f}" "${out}"
      fi
    done
  done
}

#######################################
# Command: xiso (rename XISO .iso to .xiso).
# Globals:
#   ROMS, XISO_MAGIC
# Arguments:
#   System names.
#######################################
cmd_xiso() {
  local sys f out
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == xbox ]] || continue
    for f in "${ROMS}/${sys}"/*.iso; do
      [[ -f "${f}" ]] || continue
      if [[ "$(read_hex "${f}" 65536 20)" != "${XISO_MAGIC}" ]]; then
        err "not an XISO, skipped (rebuild with extract-xiso -r): ${f}"
        continue
      fi
      out="${f%.*}.xiso"
      [[ -e "${out}" ]] && continue
      act "rename ${sys}/${f##*/} -> ${out##*/}" && mv -n -- "${f}" "${out}"
    done
  done
}

#######################################
# Command: rvz (GameCube/Wii images to RVZ).
# Globals:
#   ROMS
# Arguments:
#   System names.
#######################################
cmd_rvz() {
  local sys f out
  local -i failed=0
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == dolphin ]] || continue
    for f in "${ROMS}/${sys}"/*.{iso,gcm,wbfs,ciso,gcz}; do
      [[ -f "${f}" ]] || continue
      out="${f%.*}.rvz"
      [[ -e "${out}" ]] && continue
      act "convert ${sys}/${f##*/} -> ${out##*/}" || continue
      need dolphin-tool
      if dolphin-tool convert -i "${f}" -o "${out}.tmp" -f rvz -c zstd -l 5 \
        -b 131072 >/dev/null; then
        mv -- "${out}.tmp" "${out}" && retire "${f}"
      else
        rm -f -- "${out}.tmp"
        err "failed, source kept: ${f}"
        ((failed++))
      fi
    done
  done
  ((failed == 0))
}

#######################################
# Unpack PS3 archives into Title.ps3/ disc folders.
# Arguments:
#   PS3 system directory.
#######################################
ps3_unpack() {
  local sysdir="$1" a title dst tmp game root
  for a in "${sysdir}"/*.{7z,zip,rar}; do
    [[ -f "${a}" ]] || continue
    title="$(clean_name "$(basename -- "${a%.*}")")"
    dst="${sysdir}/${title}.ps3"
    [[ -e "${dst}" || -e "${sysdir}/${title}.iso" ]] && continue
    act "unpack ps3/${a##*/} -> ${title}.ps3/" || continue
    need 7z
    tmp="$(mktemp -d "${sysdir}/_extract.XXXX")" || return 1
    if ! 7z x -y -o"${tmp}" "${a}" >/dev/null; then
      err "extraction failed: ${a}"
      rm -rf -- "${tmp}"
      continue
    fi
    game="$(find "${tmp}" -maxdepth 3 -type d -name PS3_GAME -print -quit)"
    root="${game%/PS3_GAME}"
    if [[ -z "${game}" || ! -f "${game}/USRDIR/EBOOT.BIN" ]]; then
      err "not a disc dump: ${a}"
      rm -rf -- "${tmp}"
      continue
    fi
    rm -rf -- "${root}/PS3_UPDATE"
    mv -- "${root}" "${dst}" && retire "${a}"
    rm -rf -- "${tmp}"
  done
}

#######################################
# Check that an ISO9660 image is complete: primary volume descriptor present
# and declared volume size equal to the file size.
# Arguments:
#   ISO file.
#######################################
iso_complete() {
  local f="$1" magic le
  local -i sectors
  magic="$(read_hex "${f}" 32769 5)" || return 1
  [[ "${magic}" == "4344303031" ]] || return 1 # "CD001"
  le="$(read_hex "${f}" 32848 4)" || return 1
  sectors=$((16#${le:6:2}${le:4:2}${le:2:2}${le:0:2}))
  ((sectors * 2048 == $(file_size "${f}")))
}

#######################################
# Build ISOs from Title.ps3/ disc folders.
# Arguments:
#   PS3 system directory.
#######################################
ps3_iso() {
  local sysdir="$1" d iso part listing
  for d in "${sysdir}"/*.ps3/; do
    d="${d%/}"
    [[ -f "${d}/PS3_GAME/USRDIR/EBOOT.BIN" ]] || continue
    iso="${d%.ps3}.iso"
    # makeps3iso appends ".iso" to names without it; keep the suffix.
    part="${d%.ps3}.partial.iso"
    [[ -e "${iso}" ]] && continue
    act "build ps3/${iso##*/} from ${d##*/}/" || continue
    rm -f -- "${part}"
    if makeps3iso "${d}" "${part}" </dev/null >/dev/null 2>&1 &&
      iso_complete "${part}" &&
      listing="$(7z l -ba "${part}" 2>/dev/null)" &&
      [[ "${listing}" == *PS3_GAME/USRDIR/EBOOT.BIN* ]]; then
      mv -- "${part}" "${iso}" && retire "${d}"
    else
      rm -f -- "${part}"
      err "failed, folder kept: ${d}"
    fi
  done
}

#######################################
# Command: ps3.
# Globals:
#   ROMS
# Arguments:
#   System names.
#######################################
cmd_ps3() {
  local sys e
  for sys in "$@"; do
    [[ "${SYSTEM_CLASS[${sys}]:-}" == ps3 ]] || continue
    if ((APPLY)); then
      for e in "${ROMS}/${sys}"/*.{7z,zip,rar} "${ROMS}/${sys}"/*.ps3/; do
        [[ -e "${e}" ]] && need 7z
        [[ -f "${e}PS3_GAME/USRDIR/EBOOT.BIN" ]] && need makeps3iso
      done
    fi
    ps3_unpack "${ROMS}/${sys}"
    ps3_iso "${ROMS}/${sys}"
  done
}

#######################################
# Command: clean (delete _to_delete/ directories).
# Globals:
#   ROMS
# Arguments:
#   System names.
#######################################
cmd_clean() {
  local sys d size
  for sys in "$@"; do
    d="${ROMS}/${sys}/_to_delete"
    [[ -d "${d}" ]] || continue
    size="$(du -sh -- "${d}" 2>/dev/null)"
    act "delete ${sys}/_to_delete (${size%%[[:space:]]*})" && rm -rf -- "${d}"
  done
}

#######################################
# Command: systems.
# Globals:
#   SYSTEM_CLASS
#######################################
cmd_systems() {
  local s
  for s in "${!SYSTEM_CLASS[@]}"; do
    printf '%-16s %s\n' "${s}" "${SYSTEM_CLASS[${s}]}"
  done | sort
}

#######################################
# Load KEY=value settings from the config file (never sourced).
# Globals:
#   SYNC_USER, SYNC_HOST, SYNC_PATH, SYNC_EXCLUDE_USER
#######################################
load_config() {
  local file="${ROMCTL_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/romctl/config}"
  local line key value
  local -i n=0
  [[ -f "${file}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    ((n++))
    line="${line%$'\r'}"
    [[ "${line}" =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ ! "${line}" =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      die "${file}:${n}: expected KEY=value"
    fi
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    value="${value%"${value##*[![:space:]]}"}"
    if [[ "${value}" =~ ^\"(.*)\"$ || "${value}" =~ ^\'(.*)\'$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
    case "${key}" in
      SYNC_USER) SYNC_USER="${value}" ;;
      SYNC_HOST) SYNC_HOST="${value}" ;;
      SYNC_PATH) SYNC_PATH="${value%/}" ;;
      SYNC_EXCLUDE) SYNC_EXCLUDE_USER+=("${value}") ;;
      *) die "${file}:${n}: unknown key ${key}" ;;
    esac
  done <"${file}"
}

#######################################
# Command: sync. Mirror roms/ and/or bios/ to the device with rsync.
# Globals:
#   ROOT, APPLY, SYNC_*
# Arguments:
#   Targets: roms, bios (default: both).
#######################################
cmd_sync() {
  local t pattern dest
  local -a targets=("$@") opts=(-rlt --delete --human-readable)

  ((${#targets[@]} > 0)) || targets=(roms bios)
  for t in "${targets[@]}"; do
    [[ "${t}" == roms || "${t}" == bios ]] || die "sync target must be roms or bios: ${t}"
    [[ -d "${ROOT}/${t}" ]] || die "no ${t}/ directory under ${ROOT}"
  done
  [[ -n "${SYNC_USER}" && -n "${SYNC_HOST}" && -n "${SYNC_PATH}" ]] ||
    die "set SYNC_USER, SYNC_HOST and SYNC_PATH in the config file (see romctl --help)"
  need rsync ssh

  if ((APPLY)); then
    opts+=('--info=progress2,del,name0' --partial)
  else
    opts+=(--dry-run --itemize-changes)
  fi
  for pattern in "${SYNC_EXCLUDE_COMMON[@]}" "${SYNC_EXCLUDE_USER[@]}"; do
    opts+=("--exclude=${pattern}")
  done

  for t in "${targets[@]}"; do
    dest="${SYNC_USER}@${SYNC_HOST}:${SYNC_PATH}/${t}/"
    local -a extra=()
    if [[ "${t}" == bios ]]; then
      for pattern in "${SYNC_EXCLUDE_BIOS[@]}"; do
        extra+=("--exclude=${pattern}")
      done
    fi
    if ((APPLY)); then
      echo "do:   sync ${t}/ -> ${dest}"
    else
      echo "plan: sync ${t}/ -> ${dest} (dry run; lines starting with *deleting are removals)"
    fi
    rsync "${opts[@]}" "${extra[@]}" -- "${ROOT}/${t}/" "${dest}" ||
      die "rsync failed for ${t}/"
  done
}

main() {
  local cmd root="." self
  local -a args=()

  # Prefer tools built by the bundled Makefile over system copies.
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  PATH="${self%/*}/bin:${PATH}"

  # Options may appear anywhere; "--" ends option parsing.
  while (($# > 0)); do
    case "$1" in
      -r | --root)
        (($# >= 2)) || die "missing argument to $1"
        root="$2"
        shift 2
        ;;
      --root=*)
        root="${1#*=}"
        shift
        ;;
      --apply)
        APPLY=1
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      --)
        shift
        args+=("$@")
        break
        ;;
      -*) die "unknown option: $1 (see romctl --help)" ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  if ((${#args[@]} == 0)); then
    usage
    return 1
  fi
  cmd="${args[0]}"
  args=("${args[@]:1}")

  ROOT="${root%/}"
  ROMS="${ROOT}/roms"
  BIOS="${ROOT}/bios"
  readonly ROOT ROMS BIOS APPLY

  case "${cmd}" in
    help)
      usage
      return 0
      ;;
    systems)
      cmd_systems
      return
      ;;
    sync)
      load_config
      save_tty
      cmd_sync "${args[@]}"
      return
      ;;
    check | bios | detag | unpack | chd | m3u | dvd | n64 | snes | xiso | rvz | ps3 | clean) ;;
    *) die "unknown command: ${cmd} (see romctl --help)" ;;
  esac

  [[ -d "${ROMS}" ]] || die "no roms/ directory under ${ROOT} (use -r)"
  save_tty
  need perl od md5sum stat
  shopt -s nullglob
  resolve_systems "${args[@]}"
  "cmd_${cmd}" "${SYSTEMS[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # Exit inside the guard so bash never reads past this block; a script
  # edited while running cannot then execute partial new content.
  main "$@"
  exit
fi
